# Shell example only. The service does not read this file automatically.
# Supply real catalogue files and a database URL secret before startup.
# Source this file from the project root, then run: cargo run --locked
# Relative paths start at the process working directory.

export WALLET_PROXY_LISTEN='0.0.0.0:3000'
export WALLET_PROXY_HEALTH_TOLERANCE_SECONDS='300'
export WALLET_PROXY_ENABLE_PUBLIC_CORS='false'
export WALLET_PROXY_LOG_FILTER='info'

# Supply the database URL through the deployment environment or secret manager.
# Replace this placeholder. Do not commit real credentials.
export WALLET_PROXY_DATABASE_URL='postgresql://user:password@localhost/transaction-outcome'
# The pool limit is independent of the database URL and must be positive.
export WALLET_PROXY_DATABASE_MAX_CONNECTIONS='10'

# The node endpoint is required. Replace this example with your deployment's node.
export WALLET_PROXY_NODE_ENDPOINT='https://node.example:20000'
export WALLET_PROXY_NODE_TIMEOUT_SECONDS='15'
export WALLET_PROXY_NODE_CONNECT_RETRIES='0'
# Use an https:// node endpoint for TLS with system trust roots and host name checks.
# The SDK does not support WALLET_PROXY_NODE_TARGET. See the README.

export WALLET_PROXY_IP_DATA='catalogs/v0.json'
export WALLET_PROXY_IP_DATA_V1='catalogs/v1.json'
export WALLET_PROXY_IP_DATA_V2='catalogs/v2.json'

# Optional Transak purchase sessions. Keep disabled unless explicitly configured.
export WALLET_PROXY_ENABLE_TRANSAK='false'
# export WALLET_PROXY_TRANSAK_USE_STAGING='true'
# Supply WALLET_PROXY_TRANSAK_API_KEY and WALLET_PROXY_TRANSAK_API_SECRET through
# secret-managed environment variables. Do not commit their real values.
# export WALLET_PROXY_TRANSAK_REFERRER_DOMAIN='wallet.example'
# export WALLET_PROXY_TRANSAK_USER_IP_SOURCE='remote-address'
# export WALLET_PROXY_TRANSAK_ALLOWED_ORIGINS='https://wallet.example,http://localhost:8080'
